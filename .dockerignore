# Anything not needed inside the build context. Keeping this file lean is
# the single biggest factor in fast Docker builds — every byte listed below
# is bytes that don't have to be tar'd and sent to the daemon, and that
# can't accidentally bust the layer cache.

# ─── VCS & editor ──
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store

# ─── Docker meta (avoid recursion / leaking secrets) ──
Dockerfile
.dockerignore
docker-compose*.yml

# ─── Node ──
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Next.js build artifacts (rebuilt inside the image) ──
.next
out

# ─── Local dev / test artifacts ──
.playwright-cli
test-results
playwright-report
coverage
*.log

# ─── Env files: NEVER bake secrets into images ──
.env
.env.*
!.env.example

# ─── Misc ──
README.md
LICENSE
.windsurf
.cascade
